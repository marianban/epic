{
  "inspector": {
    "enabled": false,
    "port": 8080,
    "autoOpen": true
  },
  "maxScoutRounds": 3,
  "commandTimeoutMs": 120000,
  "agentTimeoutMs": 300000,
  "maxOutputBytes": 20000,
  "maxTaskRepairs": 6,
  "maxAcceptancePlanRepairs": 2,
  "maxTaskInfrastructureRetries": 1,
  "taskVerificationTimeoutMs": 1800000,
  "checks": {
    "fast": ["git diff --check", "npm run typecheck", "npm run lint"],
    "full": [
      "npm test -- --run",
      "npm run build",
      "fallow check --format json"
    ],
    "focusedTests": "npm test -- --run",
    "fallow": "fallow check --format json",
    "browserSmoke": {
      "startupTimeoutMs": 30000,
      "navigationTimeoutMs": 15000,
      "selectorTimeoutMs": 10000,
      "settleTimeoutMs": 500
    }
  },
  "agents": {
    "scout": {
      "provider": "openai-codex",
      "model": "gpt-5.6-luna",
      "thinking": "low"
    },
    "planner": {
      "provider": "openai-codex",
      "model": "gpt-5.6-luna",
      "thinking": "high"
    },
    "task-planner": {
      "provider": "openai-codex",
      "model": "gpt-5.6-luna",
      "thinking": "high"
    },
    "plan-reviewer": {
      "provider": "openai-codex",
      "model": "gpt-5.6-luna",
      "thinking": "low"
    },
    "implementer": {
      "provider": "openai-codex",
      "model": "gpt-5.6-luna",
      "thinking": "low"
    },
    "task-reviewer": {
      "provider": "openai-codex",
      "model": "gpt-5.6-luna",
      "thinking": "low"
    },
    "verification-planner": {
      "provider": "openai-codex",
      "model": "gpt-5.6-luna",
      "thinking": "high"
    },
    "verifier": {
      "provider": "openai-codex",
      "model": "gpt-5.6-luna",
      "thinking": "high"
    },
    "reviewer": {
      "provider": "openai-codex",
      "model": "gpt-5.6-luna",
      "thinking": "medium"
    }
  }
}

{
  "inspector": {
    "enabled": false,
    "port": 8080,
    "autoOpen": true
  },
  "maxScoutRounds": 3,
  "commandTimeoutMs": 120000,
  "agentTimeoutMs": 300000,
  "maxOutputBytes": 20000,
  "maxFastRepairs": 2,
  "maxFullRepairs": 1,
  "maxSemanticRepairs": 2,
  "checks": {
    "fast": ["git diff --check", "npm run typecheck", "npm run lint"],
    "full": [
      "npm test -- --run",
      "npm run build",
      "fallow check --format json"
    ],
    "focusedTests": "npm test -- --run",
    "fallow": "fallow check --format json"
  },
  "agents": {
    "scout": {
      "provider": "openai-codex",
      "model": "gpt-5.6-luna",
      "thinking": "low"
    },
    "planner": {
      "provider": "openai-codex",
      "model": "gpt-5.6-luna",
      "thinking": "high"
    },
    "plan-reviewer": {
      "provider": "openai-codex",
      "model": "gpt-5.6-luna",
      "thinking": "low"
    },
    "implementer": {
      "provider": "openai-codex",
      "model": "gpt-5.6-luna",
      "thinking": "low"
    },
    "task-reviewer": {
      "provider": "openai-codex",
      "model": "gpt-5.6-luna",
      "thinking": "low"
    },
    "reviewer": {
      "provider": "openai-codex",
      "model": "gpt-5.6-luna",
      "thinking": "medium"
    }
  }
}
